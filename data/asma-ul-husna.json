{
  "id": "asma-ul-husna",
  "title": "أسماء الله الحسنى",
  "intro": {
    "text": "إِنَّ لِلَّهِ تِسْعَةً وَتِسْعِينَ اسْمًا، مِائَةً إِلَّا وَاحِدًا، مَنْ أَحْصَاهَا دَخَلَ الْجَنَّةَ",
    "source": { "type": "hadith", "reference": "متفق عليه", "grade": "صحيح" },
    "virtue": "والأسماء المذكورة أدناه من الأسماء الحسنى الواردة في القرآن الكريم والسنة النبوية، جُمعت من مصادر إسلامية متعددة."
  },
  "items": [
    { "id": "ah-1", "text": "اللهُ", "virtue": "الاسم الجامع لجميع صفات الكمال، وهو أخص أسماء الله وأعرفها.", "count": 1, "source": { "type": "quran", "reference": "سورة الإخلاص، الآية 1" } },
    { "id": "ah-2", "text": "الرَّحْمَٰنُ", "virtue": "ذو الرحمة الواسعة العامة التي شملت جميع الخلق.", "count": 1, "source": { "type": "quran", "reference": "سورة الفاتحة، الآية 3" } },
    { "id": "ah-3", "text": "الرَّحِيمُ", "virtue": "ذو الرحمة الخاصة الواسعة بالمؤمنين.", "count": 1, "source": { "type": "quran", "reference": "سورة الفاتحة، الآية 3" } },
    { "id": "ah-4", "text": "الْمَلِكُ", "virtue": "المالك المتصرف في كل شيء دون منازع.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 23" } },
    { "id": "ah-5", "text": "الْقُدُّوسُ", "virtue": "المنزّه عن كل نقص وعيب.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 23" } },
    { "id": "ah-6", "text": "السَّلَامُ", "virtue": "السالم من كل عيب، ومصدر السلامة والأمان لخلقه.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 23" } },
    { "id": "ah-7", "text": "الْمُؤْمِنُ", "virtue": "مصدّق رسله بالمعجزات، ومؤمِّن عباده من الظلم.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 23" } },
    { "id": "ah-8", "text": "الْمُهَيْمِنُ", "virtue": "الرقيب الحافظ الشاهد على كل شيء.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 23" } },
    { "id": "ah-9", "text": "الْعَزِيزُ", "virtue": "الغالب القوي الذي لا يُغلب.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 23" } },
    { "id": "ah-10", "text": "الْجَبَّارُ", "virtue": "الذي يجبر الضعف والنقص، ويقهر خلقه بعظمته.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 23" } },
    { "id": "ah-11", "text": "الْمُتَكَبِّرُ", "virtue": "المتعالي عن صفات الخلق ونقائصهم.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 23" } },
    { "id": "ah-12", "text": "الْخَالِقُ", "virtue": "الموجِد للأشياء جميعًا من العدم.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 24" } },
    { "id": "ah-13", "text": "الْبَارِئُ", "virtue": "المُنشئ للخلق على غير مثال سابق.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 24" } },
    { "id": "ah-14", "text": "الْمُصَوِّرُ", "virtue": "الذي يعطي كل مخلوق صورته الخاصة به.", "count": 1, "source": { "type": "quran", "reference": "سورة الحشر، الآية 24" } },
    { "id": "ah-15", "text": "الْغَفَّارُ", "virtue": "كثير المغفرة لذنوب عباده مهما عظمت.", "count": 1, "source": { "type": "quran", "reference": "سورة طه، الآية 82" } },
    { "id": "ah-16", "text": "الْقَهَّارُ", "virtue": "الغالب لكل شيء، القاهر لكل جبار عنيد.", "count": 1, "source": { "type": "quran", "reference": "سورة الرعد، الآية 16" } },
    { "id": "ah-17", "text": "الْوَهَّابُ", "virtue": "كثير العطاء بلا مقابل ولا منّة.", "count": 1, "source": { "type": "quran", "reference": "سورة آل عمران، الآية 8" } },
    { "id": "ah-18", "text": "الرَّزَّاقُ", "virtue": "الذي يرزق جميع خلقه ويتكفل بأقواتهم.", "count": 1, "source": { "type": "quran", "reference": "سورة الذاريات، الآية 58" } },
    { "id": "ah-19", "text": "الْفَتَّاحُ", "virtue": "الذي يفتح أبواب الرحمة والرزق لعباده، ويحكم بينهم بالحق.", "count": 1, "source": { "type": "quran", "reference": "سورة سبأ، الآية 26" } },
    { "id": "ah-20", "text": "الْعَلِيمُ", "virtue": "المحيط علمه بكل شيء ظاهرًا وباطنًا.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 29" } },
    { "id": "ah-21", "text": "الْقَابِضُ", "virtue": "يقبض الأرزاق والأرواح بحكمته.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-22", "text": "الْبَاسِطُ", "virtue": "يبسط الرزق لمن يشاء من عباده ويوسّعه.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-23", "text": "الْخَافِضُ", "virtue": "يخفض الجبابرة والعصاة ويذلهم.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-24", "text": "الرَّافِعُ", "virtue": "يرفع أولياءه المؤمنين ويعلي شأنهم.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-25", "text": "الْمُعِزُّ", "virtue": "يهب العزة لمن يشاء من عباده.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-26", "text": "الْمُذِلُّ", "virtue": "يذل من يشاء بعدله وحكمته.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-27", "text": "السَّمِيعُ", "virtue": "يسمع كل شيء ولو خفي أو دقّ.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 127" } },
    { "id": "ah-28", "text": "الْبَصِيرُ", "virtue": "يرى كل شيء ولو دقّ في الظلمات.", "count": 1, "source": { "type": "quran", "reference": "سورة الحجرات، الآية 18" } },
    { "id": "ah-29", "text": "الْحَكَمُ", "virtue": "الفيصل الذي يحكم بين خلقه بالعدل.", "count": 1, "source": { "type": "hadith", "reference": "رواه أبو داود والترمذي", "grade": "صحيح" } },
    { "id": "ah-30", "text": "الْعَدْلُ", "virtue": "المنزّه عن الجور، الذي لا يظلم أحدًا مثقال ذرة.", "count": 1, "source": { "type": "hadith", "reference": "رواه أحمد", "grade": "صحيح" } },
    { "id": "ah-31", "text": "اللَّطِيفُ", "virtue": "الرفيق بعباده، العالم بدقائق أمورهم.", "count": 1, "source": { "type": "quran", "reference": "سورة الملك، الآية 14" } },
    { "id": "ah-32", "text": "الْخَبِيرُ", "virtue": "المطّلع على بواطن الأمور وخفاياها.", "count": 1, "source": { "type": "quran", "reference": "سورة الملك، الآية 14" } },
    { "id": "ah-33", "text": "الْحَلِيمُ", "virtue": "الذي لا يعاجل العصاة بالعقوبة مع قدرته عليها.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 235" } },
    { "id": "ah-34", "text": "الْعَظِيمُ", "virtue": "العظيم الذي لا نهاية لعظمته وجلاله.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 255" } },
    { "id": "ah-35", "text": "الْغَفُورُ", "virtue": "الساتر للذنوب، الغافر لها مهما كثرت.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 173" } },
    { "id": "ah-36", "text": "الشَّكُورُ", "virtue": "الذي يثيب على القليل من الطاعة بالكثير من الثواب.", "count": 1, "source": { "type": "quran", "reference": "سورة فاطر، الآية 30" } },
    { "id": "ah-37", "text": "الْعَلِيُّ", "virtue": "المتعالي في ذاته وصفاته عن جميع خلقه.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 255" } },
    { "id": "ah-38", "text": "الْكَبِيرُ", "virtue": "الأعظم من كل شيء، الذي لا أكبر منه.", "count": 1, "source": { "type": "quran", "reference": "سورة الرعد، الآية 9" } },
    { "id": "ah-39", "text": "الْحَفِيظُ", "virtue": "الذي يحفظ كل شيء ويحفظ عباده الصالحين.", "count": 1, "source": { "type": "quran", "reference": "سورة هود، الآية 57" } },
    { "id": "ah-40", "text": "الْمُقِيتُ", "virtue": "المقتدر على كل شيء، وقيل هو الذي يعطي الأقوات.", "count": 1, "source": { "type": "quran", "reference": "سورة النساء، الآية 85" } },
    { "id": "ah-41", "text": "الْحَسِيبُ", "virtue": "الكافي عباده، المحاسب لهم على أعمالهم.", "count": 1, "source": { "type": "quran", "reference": "سورة النساء، الآية 6" } },
    { "id": "ah-42", "text": "الْجَلِيلُ", "virtue": "صاحب الجلال والعظمة والكبرياء.", "count": 1, "source": { "type": "quran", "reference": "سورة الرحمن، الآية 27" } },
    { "id": "ah-43", "text": "الْكَرِيمُ", "virtue": "كثير الخير، الجواد المعطي بلا حساب.", "count": 1, "source": { "type": "quran", "reference": "سورة النمل، الآية 40" } },
    { "id": "ah-44", "text": "الرَّقِيبُ", "virtue": "المطّلع على كل شيء، لا يغيب عنه شيء.", "count": 1, "source": { "type": "quran", "reference": "سورة النساء، الآية 1" } },
    { "id": "ah-45", "text": "الْمُجِيبُ", "virtue": "الذي يجيب دعاء من دعاه وسأله.", "count": 1, "source": { "type": "quran", "reference": "سورة هود، الآية 61" } },
    { "id": "ah-46", "text": "الْوَاسِعُ", "virtue": "الواسع العلم والرحمة والفضل لكل خلقه.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 268" } },
    { "id": "ah-47", "text": "الْحَكِيمُ", "virtue": "الذي يضع الأمور في مواضعها بحكمته البالغة.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 129" } },
    { "id": "ah-48", "text": "الْوَدُودُ", "virtue": "المحب لأوليائه، المحبوب في قلوب أهل طاعته.", "count": 1, "source": { "type": "quran", "reference": "سورة البروج، الآية 14" } },
    { "id": "ah-49", "text": "الْمَجِيدُ", "virtue": "العظيم المتصف بصفات الجلال والكمال.", "count": 1, "source": { "type": "quran", "reference": "سورة البروج، الآية 15" } },
    { "id": "ah-50", "text": "الْبَاعِثُ", "virtue": "الذي يبعث الخلق من قبورهم يوم القيامة.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-51", "text": "الشَّهِيدُ", "virtue": "المطّلع الحاضر الذي لا يغيب عنه شيء.", "count": 1, "source": { "type": "quran", "reference": "سورة آل عمران، الآية 98" } },
    { "id": "ah-52", "text": "الْحَقُّ", "virtue": "الثابت وجوده حقًا، الذي لا يزول ولا يتغير.", "count": 1, "source": { "type": "quran", "reference": "سورة الحج، الآية 6" } },
    { "id": "ah-53", "text": "الْوَكِيلُ", "virtue": "الكافي لمن توكل عليه واعتمد أمره إليه.", "count": 1, "source": { "type": "quran", "reference": "سورة آل عمران، الآية 173" } },
    { "id": "ah-54", "text": "الْقَوِيُّ", "virtue": "كامل القوة والقدرة الذي لا يعجزه شيء.", "count": 1, "source": { "type": "quran", "reference": "سورة الحج، الآية 40" } },
    { "id": "ah-55", "text": "الْمَتِينُ", "virtue": "الشديد القوة الذي لا يلحقه ضعف ولا تعب.", "count": 1, "source": { "type": "quran", "reference": "سورة الذاريات، الآية 58" } },
    { "id": "ah-56", "text": "الْوَلِيُّ", "virtue": "ناصر أوليائه ومحبيه، المتولي لأمورهم.", "count": 1, "source": { "type": "quran", "reference": "سورة الشورى، الآية 28" } },
    { "id": "ah-57", "text": "الْحَمِيدُ", "virtue": "المستحق للحمد على كل حال، المحمود في ذاته وأفعاله.", "count": 1, "source": { "type": "quran", "reference": "سورة إبراهيم، الآية 8" } },
    { "id": "ah-58", "text": "الْمُحْصِي", "virtue": "الذي أحصى كل شيء عددًا وعلمًا لا يند عنه شيء.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-59", "text": "الْمُبْدِئُ", "virtue": "الذي بدأ الخلق وأوجده من العدم.", "count": 1, "source": { "type": "quran", "reference": "سورة البروج، الآية 13" } },
    { "id": "ah-60", "text": "الْمُعِيدُ", "virtue": "الذي يعيد الخلق بعد الموت للبعث والحساب.", "count": 1, "source": { "type": "quran", "reference": "سورة البروج، الآية 13" } },
    { "id": "ah-61", "text": "الْمُحْيِي", "virtue": "الذي يهب الحياة لكل حي ويحيي الموتى.", "count": 1, "source": { "type": "quran", "reference": "سورة الروم، الآية 50" } },
    { "id": "ah-62", "text": "الْمُمِيتُ", "virtue": "الذي يقدّر الموت على كل حي في وقته المحدد.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-63", "text": "الْحَيُّ", "virtue": "الحي الذي لا يموت أبدًا، له الحياة الكاملة.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 255" } },
    { "id": "ah-64", "text": "الْقَيُّومُ", "virtue": "القائم بنفسه، القائم على تدبير خلقه وشؤونهم.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 255" } },
    { "id": "ah-65", "text": "الْوَاجِدُ", "virtue": "الغني الذي لا يفتقر إلى شيء أبدًا.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-66", "text": "الْمَاجِدُ", "virtue": "الواسع الكرم والعظمة والشرف.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-67", "text": "الْوَاحِدُ", "virtue": "المتفرد بذاته وصفاته وأفعاله، لا شريك له.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 163" } },
    { "id": "ah-68", "text": "الْأَحَدُ", "virtue": "الفرد الذي لا يتجزأ ولا يشابهه أحد من خلقه.", "count": 1, "source": { "type": "quran", "reference": "سورة الإخلاص، الآية 1" } },
    { "id": "ah-69", "text": "الصَّمَدُ", "virtue": "الذي يُقصد في الحوائج، المستغني عن كل أحد.", "count": 1, "source": { "type": "quran", "reference": "سورة الإخلاص، الآية 2" } },
    { "id": "ah-70", "text": "الْقَادِرُ", "virtue": "القادر على كل شيء لا يعجزه أمر.", "count": 1, "source": { "type": "quran", "reference": "سورة الأنعام، الآية 65" } },
    { "id": "ah-71", "text": "الْمُقْتَدِرُ", "virtue": "كامل القدرة، الغالب على كل شيء بقدرته.", "count": 1, "source": { "type": "quran", "reference": "سورة القمر، الآية 42" } },
    { "id": "ah-72", "text": "الْمُقَدِّمُ", "virtue": "الذي يقدّم من يشاء من خلقه بفضله وحكمته.", "count": 1, "source": { "type": "hadith", "reference": "رواه مسلم", "grade": "صحيح" } },
    { "id": "ah-73", "text": "الْمُؤَخِّرُ", "virtue": "الذي يؤخر من يشاء من خلقه بحكمته.", "count": 1, "source": { "type": "hadith", "reference": "رواه مسلم", "grade": "صحيح" } },
    { "id": "ah-74", "text": "الْأَوَّلُ", "virtue": "الذي ليس قبله شيء، الأزلي بلا بداية.", "count": 1, "source": { "type": "quran", "reference": "سورة الحديد، الآية 3" } },
    { "id": "ah-75", "text": "الْآخِرُ", "virtue": "الذي ليس بعده شيء، الباقي بلا نهاية.", "count": 1, "source": { "type": "quran", "reference": "سورة الحديد، الآية 3" } },
    { "id": "ah-76", "text": "الظَّاهِرُ", "virtue": "الظاهر فوق كل شيء بقدرته وقهره وأدلة وجوده.", "count": 1, "source": { "type": "quran", "reference": "سورة الحديد، الآية 3" } },
    { "id": "ah-77", "text": "الْبَاطِنُ", "virtue": "المطّلع على بواطن الأمور، القريب من خلقه علمًا.", "count": 1, "source": { "type": "quran", "reference": "سورة الحديد، الآية 3" } },
    { "id": "ah-78", "text": "الْوَالِي", "virtue": "المتولي لأمور خلقه وتدبيرها وحده.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-79", "text": "الْمُتَعَالِي", "virtue": "المنزّه عن صفات الخلق، العالي فوق كل شيء.", "count": 1, "source": { "type": "quran", "reference": "سورة الرعد، الآية 9" } },
    { "id": "ah-80", "text": "الْبَرُّ", "virtue": "المحسن إلى خلقه بجميع أنواع الإحسان والفضل.", "count": 1, "source": { "type": "quran", "reference": "سورة الطور، الآية 28" } },
    { "id": "ah-81", "text": "التَّوَّابُ", "virtue": "الذي يوفق عبده للتوبة ثم يقبلها منه.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 37" } },
    { "id": "ah-82", "text": "الْمُنْتَقِمُ", "virtue": "الذي ينتقم من العصاة والظالمين بعدله.", "count": 1, "source": { "type": "quran", "reference": "سورة السجدة، الآية 22" } },
    { "id": "ah-83", "text": "الْعَفُوُّ", "virtue": "الذي يمحو السيئات ويتجاوز عن الزلات.", "count": 1, "source": { "type": "quran", "reference": "سورة النساء، الآية 99" } },
    { "id": "ah-84", "text": "الرَّؤُوفُ", "virtue": "شديد الرحمة والرأفة بعباده.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 143" } },
    { "id": "ah-85", "text": "مَالِكُ الْمُلْكِ", "virtue": "المتصرف في الملك كله، يعطيه وينزعه ممن يشاء.", "count": 1, "source": { "type": "quran", "reference": "سورة آل عمران، الآية 26" } },
    { "id": "ah-86", "text": "ذُو الْجَلَالِ وَالْإِكْرَامِ", "virtue": "صاحب العظمة والجلال، والكرم الواسع لأوليائه.", "count": 1, "source": { "type": "quran", "reference": "سورة الرحمن، الآية 27" } },
    { "id": "ah-87", "text": "الْمُقْسِطُ", "virtue": "العادل في أحكامه وقضائه بين خلقه.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-88", "text": "الْجَامِعُ", "virtue": "الذي يجمع الخلائق كلها ليوم لا ريب فيه.", "count": 1, "source": { "type": "quran", "reference": "سورة آل عمران، الآية 9" } },
    { "id": "ah-89", "text": "الْغَنِيُّ", "virtue": "الغني عن خلقه أجمعين، لا يحتاج إلى أحد.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 267" } },
    { "id": "ah-90", "text": "الْمُغْنِي", "virtue": "الذي يغني من يشاء من عباده بفضله.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-91", "text": "الْمَانِعُ", "virtue": "الذي يمنع عن أوليائه ما يضرهم بحكمته.", "count": 1, "source": { "type": "hadith", "reference": "رواه البخاري ومسلم", "grade": "صحيح" } },
    { "id": "ah-92", "text": "الضَّارُّ", "virtue": "الذي يقدّر الضر لمن يشاء بحكمته وعدله.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-93", "text": "النَّافِعُ", "virtue": "الذي يقدّر النفع لمن يشاء من عباده.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-94", "text": "النُّورُ", "virtue": "المنوّر للسماوات والأرض، هادي القلوب إلى الحق.", "count": 1, "source": { "type": "quran", "reference": "سورة النور، الآية 35" } },
    { "id": "ah-95", "text": "الْهَادِي", "virtue": "الذي يهدي عباده إلى الحق وصراطه المستقيم.", "count": 1, "source": { "type": "quran", "reference": "سورة الحج، الآية 54" } },
    { "id": "ah-96", "text": "الْبَدِيعُ", "virtue": "مبدع الخلق ومنشئه على غير مثال سابق.", "count": 1, "source": { "type": "quran", "reference": "سورة البقرة، الآية 117" } },
    { "id": "ah-97", "text": "الْبَاقِي", "virtue": "الدائم الذي لا يفنى ولا يزول.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } },
    { "id": "ah-98", "text": "الْوَارِثُ", "virtue": "الباقي بعد فناء خلقه، الذي يرث كل شيء.", "count": 1, "source": { "type": "quran", "reference": "سورة الحجر، الآية 23" } },
    { "id": "ah-99", "text": "الصَّبُورُ", "virtue": "الذي لا يعاجل العصاة بالعقوبة، ويمهلهم رحمة بهم.", "count": 1, "source": { "type": "hadith", "reference": "رواه الترمذي", "grade": "حسن" } }
  ]
}
